service vendor.fingerprint-transsion /vendor/bin/hw/android.hardware.biometrics.fingerprint-service.transsion default
    class late_start
    user system
    group system input uhid
    writepid /dev/cpuset/system-background/tasks
    interface aidl android.hardware.biometrics.fingerprint.IFingerprint/default
    task_profiles ProcessCapacityHigh
    capabilities SYS_NICE

on boot
    stop vendor.fingerprint-default
    setprop vendor.fingerprint.aidl.support 1

on post-fs-data
    write /proc/gesture_function fp1